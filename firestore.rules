rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validBoard(boardId) {
      return boardId.matches('^[0-9]{4}-(0[1-9]|1[0-2])-grade-[1-6]$');
    }

    function validEntry(data) {
      return data.keys().hasOnly([
          'uid', 'name', 'score', 'correct', 'character', 'kills',
          'maxCombo', 'elapsedMs', 'gameOver', 'achievedAt', 'updatedAt'
        ])
        && data.uid is string
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 8
        && data.score is int
        && data.score >= 0
        && data.score <= 8000
        && data.correct is int
        && data.correct >= 0
        && data.correct <= 10
        && data.character in ['castor', 'kairi', 'sota', 'kappa']
        && data.kills is int
        && data.kills >= 0
        && data.kills <= 10
        && data.kills <= data.correct
        && data.maxCombo is int
        && data.maxCombo >= 0
        && data.maxCombo <= 10
        && data.maxCombo <= data.correct
        && data.elapsedMs is int
        && data.elapsedMs >= 0
        && data.elapsedMs <= 3600000
        && data.gameOver is bool
        && data.score >= data.correct * 300 + data.kills * 220 + data.maxCombo * 70
        && data.score <= data.correct * 300 + data.kills * 220 + data.maxCombo * 70 + 1800
        && (!data.gameOver
          || data.score == data.correct * 300 + data.kills * 220 + data.maxCombo * 70)
        && data.achievedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function sameResultAsBefore() {
      return request.resource.data.score == resource.data.score
        && request.resource.data.correct == resource.data.correct
        && request.resource.data.character == resource.data.character
        && request.resource.data.kills == resource.data.kills
        && request.resource.data.maxCombo == resource.data.maxCombo
        && request.resource.data.elapsedMs == resource.data.elapsedMs
        && request.resource.data.gameOver == resource.data.gameOver
        && request.resource.data.achievedAt == resource.data.achievedAt;
    }

    match /rankings/{boardId}/entries/{entryId} {
      allow read: if signedIn() && validBoard(boardId);

      allow create: if signedIn()
        && validBoard(boardId)
        && entryId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validEntry(request.resource.data)
        && request.resource.data.achievedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && validBoard(boardId)
        && entryId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.score > resource.data.score
            && request.resource.data.achievedAt == request.time)
          || sameResultAsBefore()
        );

      allow delete: if false;
    }

    function validKitchenBoard(boardId) {
      return boardId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validKitchenEntry(data) {
      let total = data.correct + data.misses;
      return data.keys().hasAll([
          'uid', 'name', 'served', 'correct', 'misses', 'elapsedMs',
          'roundId', 'accuracy', 'score', 'achievedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'served', 'correct', 'misses', 'elapsedMs',
          'roundId', 'accuracy', 'score', 'achievedAt', 'updatedAt'
        ])
        && data.uid is string
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 8
        && data.served is int && data.served >= 1 && data.served <= 62
        && data.correct is int && data.correct >= data.served * 3 && data.correct <= 100000
        && data.misses is int && data.misses >= 0 && data.misses <= 100000
        && data.elapsedMs == 180000
        && data.roundId is string && data.roundId.size() >= 1 && data.roundId.size() <= 64
        && data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 10000
        && data.accuracy * total >= data.correct * 10000 - total / 2
        && data.accuracy * total <= data.correct * 10000 + total / 2
        && data.score is int && data.score == data.served * 10001 + data.accuracy
        && data.achievedAt is timestamp && data.updatedAt is timestamp;
    }

    match /kitchenRankings/{boardId}/entries/{entryId} {
      allow read: if signedIn() && validKitchenBoard(boardId);
      allow create: if signedIn() && validKitchenBoard(boardId)
        && entryId == request.auth.uid && request.resource.data.uid == request.auth.uid
        && validKitchenEntry(request.resource.data)
        && request.resource.data.achievedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && validKitchenBoard(boardId)
        && entryId == request.auth.uid && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validKitchenEntry(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.score > resource.data.score
            && request.resource.data.achievedAt == request.time)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        );
      allow delete: if false;
    }

    function validShortKitchenBoard(boardId) {
      return boardId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validShortKitchenEntry(data) {
      let total = data.correct + data.misses;
      return data.keys().hasAll([
          'uid', 'name', 'served', 'correct', 'misses', 'elapsedMs',
          'roundId', 'accuracy', 'score', 'achievedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'served', 'correct', 'misses', 'elapsedMs',
          'roundId', 'accuracy', 'score', 'achievedAt', 'updatedAt'
        ])
        && data.uid is string
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 8
        && data.served is int && data.served >= 1 && data.served <= 41
        && data.correct is int && data.correct >= data.served * 3 && data.correct <= 100000
        && data.misses is int && data.misses >= 0 && data.misses <= 100000
        && data.elapsedMs == 120000
        && data.roundId is string && data.roundId.size() >= 1 && data.roundId.size() <= 64
        && data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 10000
        && data.accuracy * total >= data.correct * 10000 - total / 2
        && data.accuracy * total <= data.correct * 10000 + total / 2
        && data.score is int && data.score == data.served * 10001 + data.accuracy
        && data.achievedAt is timestamp && data.updatedAt is timestamp;
    }

    match /kitchenRankings2Min/{boardId}/entries/{entryId} {
      allow read: if signedIn() && validShortKitchenBoard(boardId);
      allow create: if signedIn() && validShortKitchenBoard(boardId)
        && entryId == request.auth.uid && request.resource.data.uid == request.auth.uid
        && validShortKitchenEntry(request.resource.data)
        && request.resource.data.achievedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && validShortKitchenBoard(boardId)
        && entryId == request.auth.uid && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && validShortKitchenEntry(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.score > resource.data.score
            && request.resource.data.achievedAt == request.time)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        );
      allow delete: if false;
    }

  }
}
